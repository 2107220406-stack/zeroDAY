# MySQL 数据库连接配置示例
# 请将此文件复制为 .env，并根据你的实际环境填写真实的配置。
# 注意：不要将包含真实密码的 .env 文件提交到 Git！

# 数据库主机地址（通常本地开发为 127.0.0.1 或 localhost）
MYSQL_HOST=127.0.0.1

# 数据库端口（MySQL 默认是 3306）
MYSQL_PORT=3306

# 数据库用户名
MYSQL_USER=root

# 数据库密码（请替换为你自己的真实密码，.env.example 中建议留空或写占位符）
MYSQL_PASSWORD=

# 数据库名称（代码中如果不存在会自动创建）
MYSQL_DATABASE=word_lab